%% F1 — RAG pipeline and evaluation workflow (Scopus/WoS detail level)
%% Source for review/editing. Rendered print image: F1_pipeline.png / F1_pipeline.pdf
%% Mermaid flowchart (top-down with four lanes). Paste into any Mermaid renderer.
flowchart TB
  subgraph KB["A · Knowledge base build"]
    direction TB
    S1["Public bank pages<br/>8 countries · FAQ / help / fraud / policy"]
    S2["4 manual PDFs<br/>kb_raw/manual_downloads"]
    S3["64 markdown files<br/>kb_raw + manifest.json"]
    S1 --> S3
    S2 --> S3
  end
  subgraph IDX["B · Indexing (build_index.py)"]
    direction TB
    C1["Chunking<br/>1000 chars · overlap 200 · drop &lt;200"]
    C2["Embeddings<br/>all-MiniLM-L6-v2"]
    C3["ChromaDB collection bank_kb<br/>cosine space · fresh rebuild"]
    S3 --> C1 --> C2 --> C3
  end
  subgraph RUN["C · Query-time agent — one flow, both tiers (crew_agent.py)"]
    direction TB
    Q["User query<br/>+ gold act: answer / clarify / abstain / escalate / refuse"]
    R["Retriever<br/>top-4 chunks from bank_kb"]
    B["Banking specialist<br/>context-only draft · max 80 words"]
    T1["Tool · check_loan_eligibility<br/>need_info / deny / manual review"]
    T2["Tool · flag_fraud_report<br/>case ID + hand-off · never a verdict"]
    G["Compliance gate<br/>pass OR short decline + referral · max 40 words"]
    A["Agent reply<br/>+ Abstained flag (first 300 chars)<br/>+ Confidence = top-1 retrieval similarity"]
    Q --> R
    C3 --> R
    R --> B
    B <--> T1
    B <--> T2
    B --> G
    G --> A
  end
  subgraph EVAL["D · Scoring — 100 queries x 2 tiers"]
    direction TB
    J["Three sources per reply<br/>author + classmate + blind third-model<br/>pass / fail + 1 of 5 reasons"]
    H["2-of-3 majority → primary label<br/>each source as sensitivity<br/>per-ID log, no adjudication"]
    M["Metrics<br/>Wilson 95% CI · exact McNemar + Holm<br/>Fleiss + agree + AC1 · consensus + Mixed"]
    A --> J --> H --> M
  end
  KB --> IDX --> RUN --> EVAL
  classDef note fill:#f2f2f2,stroke:#666,stroke-dasharray:4 2;
